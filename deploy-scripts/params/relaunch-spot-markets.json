		"if_liquidation_fee": "insurance-fund share on spot liquidations, 1e6",
		"scale_initial_asset_weight_start": "deposits TVL (USD 1e6) above which initial asset weight starts scaling down; 0 = never",
		"withdraw_guard_threshold": "token amount (mint decimals) below which withdraw guards do not bind",
		"order_tick_size": "spot order price tick, PRICE_PRECISION 1e6; init-only, not synced on existing markets",
		"order_step_size": "spot order size step, mint decimals; init-only, not synced on existing markets",
		"if_total_factor": "share of borrow interest routed to the insurance fund, 1e6 (onchain field: insurance_fund.if_fee_factor; tuned post-init via spot-market set-fee-factors)",
		"max_token_deposits": "deposit cap, token amount in mint decimals; 0 = uncapped",
		"max_token_borrows_fraction": "borrow cap as fraction of max_token_deposits, 1e4 = 100%; 0 = uncapped",
		"deposit_cap_usd": "USD intent for max_token_deposits, whole dollars; when non-null the token cap is re-derived at the live oracle price on sync (2% tolerance); null = use max_token_deposits as-is",
		"withdraw_guard_usd": "USD intent for withdraw_guard_threshold, same semantics as deposit_cap_usd"
	},
